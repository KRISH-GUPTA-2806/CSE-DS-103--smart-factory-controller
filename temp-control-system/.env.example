# ---- HiveMQ Cloud (Cluster > Overview > Connection details) ----
MQTT_HOST=your-cluster-id.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_hivemq_user
MQTT_PASSWORD=your_hivemq_password

# ---- PostgreSQL ----
POSTGRES_USER=tempctl
POSTGRES_PASSWORD=tempctl_pass
POSTGRES_DB=tempctl
DB_HOST=localhost
DB_PORT=5432

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---- Control settings ----
DEFAULT_SETPOINT=24.0
HYSTERESIS=0.5
PUBLISH_INTERVAL=2
